# AdaptiAuth — Environment Configuration
# Copy this file to .env and fill in the values.

# ─── Application ───────────────────────────────────────────────
APP_NAME=AdaptiAuth
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-secret-key-in-production
API_HOST=0.0.0.0
API_PORT=8000

# ─── Database ──────────────────────────────────────────────────
# SQLite for prototype; swap to PostgreSQL connection string for production
# DATABASE_URL=postgresql://user:password@localhost:5432/adaptiauth
DATABASE_URL=sqlite:///./adaptiauth.db

# ─── JWT / Session ─────────────────────────────────────────────
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─── Trust Engine ──────────────────────────────────────────────
TRUST_RESCORE_INTERVAL_SECONDS=5
TRUST_LOW_THRESHOLD=0.80
TRUST_MEDIUM_THRESHOLD=0.50

# ─── WebAuthn ──────────────────────────────────────────────────
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=AdaptiAuth Demo
WEBAUTHN_ORIGIN=http://localhost:5173

# ─── ML Models ─────────────────────────────────────────────────
FACIAL_MODEL_PATH=ml/facial/weights/
LIVENESS_PAD_MODEL_PATH=ml/liveness/weights/
BEHAVIORAL_MODEL_PATH=ml/behavioral/weights/

# ─── Frontend ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── SOC Alert Webhook (stub) ─────────────────────────────────
SOC_WEBHOOK_URL=http://localhost:9999/webhook/soc-alert
